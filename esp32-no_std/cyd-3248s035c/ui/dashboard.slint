// CYD-3248S035C — Minimal 3-page Slint hardware demo.
// 320x480 portrait display (ST7796 SPI).
// BOOT button: short press = next page, long press = dark mode toggle.

export global HardwareGlobals {
    in-out property <int> page: 0;
    in-out property <bool> dark-mode: false;
    in property <int> tick: 0;
    in property <bool> boot-pressed: false;

    out property <color> bg: dark-mode ? #0a0a12 : #f0f0f0;
    out property <color> surface: dark-mode ? #121624 : #ffffff;
    out property <color> text-primary: dark-mode ? #ffffff : #000000;
    out property <color> text-secondary: dark-mode ? #b7c0d8 : #4d5a73;
    out property <color> accent: dark-mode ? #00ddff : #0066cc;
    out property <color> divider: dark-mode ? #1a2a3a : #cccccc;
    out property <color> footer-bg: dark-mode ? #111122 : #e8e8f0;
    out property <color> muted: dark-mode ? #556070 : #8a8f99;

    callback page-changed(int);
}

component InfoText inherits Text {
    font-size: 16px;
    color: HardwareGlobals.text-primary;
}

export component MainWindow inherits Window {
    width: 320px;
    height: 480px;
    background: HardwareGlobals.bg;

    VerticalLayout {
        spacing: 0px;

        // ====== PAGE 0: Hardware Info ======
        if HardwareGlobals.page == 0 : Rectangle {
            vertical-stretch: 1;
            background: HardwareGlobals.bg;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text { text: "CYD-3248S035C"; font-size: 26px; font-weight: 700; color: HardwareGlobals.text-primary; }
                Text { text: "Hardware Info"; font-size: 16px; color: HardwareGlobals.accent; }
                Rectangle { height: 1px; background: HardwareGlobals.divider; }
                InfoText { text: "Chip: ESP32-WROOM-32E"; }
                InfoText { text: "Display: 320x480 ST7796 SPI"; }
                InfoText { text: "Touch: GT911 (not active)"; }
                InfoText { text: "Mode: " + (HardwareGlobals.dark-mode ? "Dark" : "Light"); }
                InfoText { text: "Page: " + (HardwareGlobals.page + 1) + "/3"; }
                Text { text: "Tick: " + HardwareGlobals.tick; font-size: 14px; color: HardwareGlobals.muted; }
                InfoText { text: "Boot BTN: " + (HardwareGlobals.boot-pressed ? "PRESSED" : "RELEASED"); }
                Rectangle { vertical-stretch: 1; }
                Text { text: "BOOT=next page | hold=dark"; font-size: 13px; color: HardwareGlobals.text-secondary; horizontal-alignment: center; }
            }
        }

        // ====== PAGE 1: Colors & Shapes ======
        if HardwareGlobals.page == 1 : Rectangle {
            vertical-stretch: 1;
            background: HardwareGlobals.bg;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text { text: "Colors & Shapes"; font-size: 26px; font-weight: 700; color: HardwareGlobals.text-primary; }
                Text { text: "ST7796 panel demo"; font-size: 16px; color: HardwareGlobals.accent; }
                Rectangle { height: 1px; background: HardwareGlobals.divider; }

                Text { text: "Color Palette"; font-size: 15px; font-weight: 600; color: HardwareGlobals.text-secondary; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle { width: 48px; height: 48px; border-radius: 8px; background: #ff5b5b; }
                    Rectangle { width: 48px; height: 48px; border-radius: 8px; background: #ffd84d; }
                    Rectangle { width: 48px; height: 48px; border-radius: 8px; background: #34d399; }
                    Rectangle { width: 48px; height: 48px; border-radius: 8px; background: #38bdf8; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle { width: 48px; height: 48px; border-radius: 8px; background: #a78bfa; }
                    Rectangle { width: 48px; height: 48px; border-radius: 8px; background: #f472b6; }
                    Rectangle { width: 48px; height: 48px; border-radius: 8px; background: #ffffff; }
                    Rectangle { width: 48px; height: 48px; border-radius: 8px; background: #1f2937; }
                }

                Text { text: "Border Radius"; font-size: 15px; font-weight: 600; color: HardwareGlobals.text-secondary; }
                HorizontalLayout {
                    spacing: 14px;
                    alignment: center;
                    Rectangle { width: 56px; height: 56px; background: HardwareGlobals.accent; border-radius: 0px; }
                    Rectangle { width: 56px; height: 56px; background: HardwareGlobals.accent; border-radius: 10px; }
                    Rectangle { width: 56px; height: 56px; background: HardwareGlobals.accent; border-radius: 18px; }
                    Rectangle { width: 56px; height: 56px; background: HardwareGlobals.accent; border-radius: 28px; }
                }

                Text { text: "Borders"; font-size: 15px; font-weight: 600; color: HardwareGlobals.text-secondary; }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    Rectangle { width: 80px; height: 40px; background: transparent; border-width: 1px; border-color: HardwareGlobals.text-primary; border-radius: 4px; }
                    Rectangle { width: 80px; height: 40px; background: transparent; border-width: 2px; border-color: #ff5b5b; border-radius: 4px; }
                    Rectangle { width: 80px; height: 40px; background: HardwareGlobals.dark-mode ? #0d1a33 : #dbeafe; border-width: 2px; border-color: HardwareGlobals.accent; border-radius: 8px; }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // ====== PAGE 2: About ======
        if HardwareGlobals.page == 2 : Rectangle {
            vertical-stretch: 1;
            background: HardwareGlobals.bg;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text { text: "About"; font-size: 26px; font-weight: 700; color: HardwareGlobals.text-primary; }
                Text { text: "Minimal Slint board port"; font-size: 16px; color: HardwareGlobals.accent; }
                Rectangle { height: 1px; background: HardwareGlobals.divider; }
                InfoText { text: "Board: CYD-3248S035C"; }
                InfoText { text: "Chip: ESP32-WROOM-32E"; }
                InfoText { text: "Flash: 4MB"; }
                InfoText { text: "Display: 320x480 ST7796 SPI"; }
                InfoText { text: "Driver: mipidsi + software"; }
                InfoText { text: "SPI: MOSI=13 SCK=14 CS=15"; }
                InfoText { text: "DC=2  RST=9  BL=27"; }
                InfoText { text: "BOOT=GPIO0: page/dark"; }
                Text { text: "Tick source: render_loop @ 330ms"; font-size: 14px; color: HardwareGlobals.muted; }
                Rectangle { vertical-stretch: 1; }
                Text { text: "slint-esp-workshop"; font-size: 13px; color: HardwareGlobals.muted; horizontal-alignment: center; }
            }
        }

        // ====== BOTTOM NAV BAR ======
        Rectangle {
            height: 28px;
            background: HardwareGlobals.footer-bg;

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                padding-top: 8px;

                Rectangle { width: HardwareGlobals.page == 0 ? 18px : 8px; height: 8px; border-radius: 4px; background: HardwareGlobals.page == 0 ? HardwareGlobals.accent : HardwareGlobals.muted; }
                Rectangle { width: HardwareGlobals.page == 1 ? 18px : 8px; height: 8px; border-radius: 4px; background: HardwareGlobals.page == 1 ? HardwareGlobals.accent : HardwareGlobals.muted; }
                Rectangle { width: HardwareGlobals.page == 2 ? 18px : 8px; height: 8px; border-radius: 4px; background: HardwareGlobals.page == 2 ? HardwareGlobals.accent : HardwareGlobals.muted; }
            }
        }
    }
}

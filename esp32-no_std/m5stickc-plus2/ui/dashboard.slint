export global HardwareGlobals {
    in-out property <int> page: 0;
    in-out property <bool> dark-mode: false;
    in property <int> tick: 0;

    out property <color> bg: dark-mode ? #0a0a12 : #f0f0f0;
    out property <color> text-primary: dark-mode ? #ffffff : #000000;
    out property <color> accent: dark-mode ? #00ddff : #0066cc;

    callback page-changed(int);
}

export component MainWindow inherits Window {
    width: 135px;
    height: 240px;
    background: HardwareGlobals.bg;

    VerticalLayout {
        VerticalLayout {
            padding: 8px;
            spacing: 4px;

            if HardwareGlobals.page == 0 : VerticalLayout {
                spacing: 4px;
                Text { text: "StickC+2"; font-size: 14px; font-weight: 700; color: HardwareGlobals.text-primary; }
                Rectangle { height: 1px; background: #333333; }
                Text { text: HardwareGlobals.dark-mode ? "Dark Mode" : "Light Mode"; font-size: 11px; color: HardwareGlobals.accent; }
                Text { text: "Tick: " + HardwareGlobals.tick; font-size: 10px; color: #888888; }
                Text { text: "Page " + (HardwareGlobals.page + 1) + "/3"; font-size: 10px; color: #888888; }
            }

            if HardwareGlobals.page == 1 : VerticalLayout {
                spacing: 4px;
                Text { text: "Colors"; font-size: 14px; font-weight: 700; color: HardwareGlobals.text-primary; }
                Rectangle { height: 1px; background: #333333; }
                HorizontalLayout {
                    spacing: 4px;
                    Rectangle { width: 32px; height: 24px; background: #ff0000; border-radius: 4px; }
                    Rectangle { width: 32px; height: 24px; background: #00ff00; border-radius: 4px; }
                    Rectangle { width: 32px; height: 24px; background: #0000ff; border-radius: 4px; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Rectangle { width: 32px; height: 24px; background: #ffff00; border-radius: 4px; }
                    Rectangle { width: 32px; height: 24px; background: #00ffff; border-radius: 4px; }
                    Rectangle { width: 32px; height: 24px; background: #ff00ff; border-radius: 4px; }
                }
            }

            if HardwareGlobals.page == 2 : VerticalLayout {
                spacing: 4px;
                Text { text: "About"; font-size: 14px; font-weight: 700; color: HardwareGlobals.text-primary; }
                Rectangle { height: 1px; background: #333333; }
                Text { text: "ESP32-PICO"; font-size: 10px; color: #888888; }
                Text { text: "ST7789 135x240"; font-size: 10px; color: #888888; }
                Text { text: "Slint Workshop"; font-size: 10px; color: #888888; }
            }
        }

        Rectangle {
            height: 20px;
            background: HardwareGlobals.dark-mode ? #111122 : #e8e8f0;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Text { text: "A:► B:◄ C:☀"; font-size: 10px; color: HardwareGlobals.accent; vertical-alignment: center; }
            }
        }
    }
}
